module

public import BGWLeaves.LeafMass.Defs
public import BGWLeaves.LeafMass.Arithmetic
public import BGWLeaves.LeafMass.LeafLocalLimit

/-!
# Exact leaf counts (M4b): the remarks and examples

Proofs of `suppNonLattice_iff`, `example_047`, `example_28_40_52`, `example_3_6` and
`exists_examples` (the exact types of the frozen statements of `BGWLeaves.LeafMass`).  The support
statements follow from `leafProb_pos_iff_mem_leafMonoid` (`P[λ = n + 1] > 0` iff `n` lies in the
additive monoid generated by the steps of `Y`) and `arithFactor_zero_eq_setGcd`; the explicit laws
are built with `PMF.ofFinset`. The periodic local limit `rem_periodic_ltn_ii` follows
from the general leaf-time local limit of `LeafLocalLimit`, including the case of
a single positive offspring atom.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory BGW.LocallyFinite BGW.StableTrees BGWLeaves
  BGWLeaves.StableAnalysis
open scoped ENNReal NNReal

namespace BGWLeaves.LeafMass.Remarks

open Filter in
open scoped Topology in
/-- The periodic extension of Theorem 3.1(ii), including constant excess laws. -/
theorem rem_periodic_ltn_ii {μ : PMF ℕ} {θ : ℝ} (hc : IsCritical μ) (hne : μ 1 ≠ 1)
    (hper : ¬ Aperiodic μ) (hDA : ∃ a, StableDomain μ θ a) :
    Tendsto (fun n : ℕ => (n : ℝ) * norming (stepLaw μ) θ n * leafProb μ (n + 1))
      (atTop ⊓ 𝓟 {n : ℕ | arithFactor μ {0} ∣ n})
      (𝓝 ((μ 0).toReal ^ (1 / θ) * Scalar.stableDensity θ 0 * (arithFactor μ {0} : ℝ))) := by
  have _ := hper
  exact LeafLocalLimit.ltn_ii_tendsto_general hc hne hDA

/-! ## The remark after Theorem 3.1 -/

theorem suppNonLattice_iff {μ : PMF ℕ} {d b : ℕ} (h : IsSuppSpan μ d b) :
    (¬ ∃ (b' : ℤ) (d' : ℕ), 2 ≤ d' ∧ ∀ k : ℕ, μ k ≠ 0 → k ≠ 0 → (d' : ℤ) ∣ (k : ℤ) - b') ↔
      d = 1 ∧ b = 0 := by
  obtain ⟨hd1, hdv, hdmax, hbmin⟩ := h
  constructor
  · intro hn
    have hd : d = 1 := by
      by_contra hd'
      exact hn ⟨b, d, by omega, hdv⟩
    subst hd
    exact ⟨rfl, Nat.le_zero.1 (hbmin 0 (fun k _ _ => by simp))⟩
  · rintro ⟨rfl, rfl⟩ ⟨b', d', hd', hk⟩
    have hmod : ∀ k : ℕ, μ k ≠ 0 → k ≠ 0 →
        (d' : ℤ) ∣ (k : ℤ) - (((b' % (d' : ℤ)).toNat : ℕ) : ℤ) := by
      intro k hk1 hk2
      have h1 := hk k hk1 hk2
      have h2 : (((b' % (d' : ℤ)).toNat : ℕ) : ℤ) = b' % (d' : ℤ) :=
        Int.toNat_of_nonneg (Int.emod_nonneg _ (by omega))
      rw [h2]
      have e : (k : ℤ) - b' % (d' : ℤ) = ((k : ℤ) - b') + (d' : ℤ) * (b' / (d' : ℤ)) := by
        rw [Int.emod_def]; ring
      rw [e]
      exact h1.add (dvd_mul_right _ _)
    have := hdmax d' (by omega) ⟨_, hmod⟩
    omega

/-! ## Helpers for the examples -/

theorem aperiodic_of_mem {μ : PMF ℕ} {m n : ℕ} (hm : μ m ≠ 0) (hn : μ n ≠ 0) (c e : ℤ)
    (h : c * m + e * n = 1) : Aperiodic μ := by
  rw [Aperiodic, eq_top_iff]
  intro x _
  have hm' : (m : ℤ) ∈ AddSubgroup.closure (((↑) : ℕ → ℤ) '' {j : ℕ | μ j ≠ 0}) :=
    AddSubgroup.subset_closure ⟨m, hm, rfl⟩
  have hn' : (n : ℤ) ∈ AddSubgroup.closure (((↑) : ℕ → ℤ) '' {j : ℕ | μ j ≠ 0}) :=
    AddSubgroup.subset_closure ⟨n, hn, rfl⟩
  have h1 : (1 : ℤ) ∈ AddSubgroup.closure (((↑) : ℕ → ℤ) '' {j : ℕ | μ j ≠ 0}) := by
    rw [← h]
    exact add_mem (by simpa using AddSubgroup.zsmul_mem _ hm' c)
      (by simpa using AddSubgroup.zsmul_mem _ hn' e)
  simpa using AddSubgroup.zsmul_mem _ h1 x

theorem not_aperiodic_of_dvd {μ : PMF ℕ} {g : ℕ} (hg : 2 ≤ g) (h : ∀ k, μ k ≠ 0 → g ∣ k) :
    ¬ Aperiodic μ := by
  intro hap
  have hle : AddSubgroup.closure (((↑) : ℕ → ℤ) '' {j : ℕ | μ j ≠ 0}) ≤
      AddSubgroup.zmultiples (g : ℤ) := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    obtain ⟨c, hc⟩ := h j hj
    rw [hc]
    exact AddSubgroup.mem_zmultiples_iff.2 ⟨c, by push_cast; ring⟩
  rw [hap] at hle
  have h1 : (1 : ℤ) ∈ AddSubgroup.zmultiples (g : ℤ) := hle trivial
  obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.1 h1
  have : (g : ℤ) ∣ 1 := ⟨n, by rw [← hn]; simp [mul_comm]⟩
  have := Int.eq_one_of_dvd_one (by positivity) this
  omega

theorem d_le_of_two_points {μ : PMF ℕ} {k₁ D : ℕ} (h1 : μ k₁ ≠ 0) (h2 : μ (k₁ + D) ≠ 0)
    (hk1 : k₁ ≠ 0) (hD : 0 < D) :
    ∀ d' : ℕ, 1 ≤ d' →
      (∃ b' : ℕ, ∀ k : ℕ, μ k ≠ 0 → k ≠ 0 → (d' : ℤ) ∣ (k : ℤ) - b') → d' ≤ D := by
  rintro d' - ⟨b', hb'⟩
  have a := hb' k₁ h1 hk1
  have b := hb' (k₁ + D) h2 (by omega)
  have := dvd_sub b a
  have e : (((k₁ + D : ℕ) : ℤ) - b') - ((k₁ : ℤ) - b') = (D : ℤ) := by push_cast; ring
  rw [e] at this
  have := Int.le_of_dvd (by exact_mod_cast hD) this
  omega

theorem leafProb_zero (μ : PMF ℕ) : leafProb μ 0 = 0 := by
  have hemp : leafCountEvent 0 = ∅ := by
    ext T
    simp only [leafCountEvent, finiteTreeEvent, Set.mem_ofPred_eq, Set.mem_empty_iff_false,
      iff_false]
    rintro ⟨t, rfl, ht⟩
    have h1 := t.sum_degrees_add_one
    have h2 : 0 ∉ t.degrees := by
      intro hmem
      have : 0 < t.degrees.count 0 := List.count_pos_iff.2 hmem
      have h3 : t.degreeCount 0 = t.degrees.count 0 := rfl
      omega
    have h4 : t.degrees.length ≤ t.degrees.sum :=
      List.length_le_sum_of_one_le _ (fun i hi => Nat.one_le_iff_ne_zero.2 (fun h0 => h2 (h0 ▸ hi)))
    rw [BGW.PlaneTree.length_degrees] at h4
    omega
  unfold leafProb
  rw [hemp]
  simp

theorem leafProb_eq_zero_iff {μ : PMF ℕ} (hc : IsCritical μ) (hne : μ 1 ≠ 1) (m : ℕ) :
    leafProb μ (m + 1) = 0 ↔ m ∉ leafMonoid μ := by
  rw [← BGWLeaves.LeafMass.Arithmetic.leafProb_pos_iff_mem_leafMonoid hc hne]
  constructor
  · intro h h'
    exact h'.ne' h
  · intro h
    exact le_antisymm (not_lt.1 h) measureReal_nonneg

theorem mu_one_ne_one {μ : PMF ℕ} (h : μ 1 = 0) : μ 1 ≠ 1 := by
  rw [h]; exact zero_ne_one

/-! ## The examples -/

theorem example_047 {μ : PMF ℕ} (hsupp : ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 4 ∨ k = 7) :
    Aperiodic μ ∧ IsSuppSpan μ 3 1 ∧ Int.gcd ((1 : ℤ) - 1) 3 = 3 := by
  have h4 : μ 4 ≠ 0 := (hsupp 4).2 (by simp)
  have h7 : μ 7 ≠ 0 := (hsupp 7).2 (by simp)
  refine ⟨aperiodic_of_mem h4 h7 2 (-1) (by norm_num), ⟨by norm_num, ?_, ?_, ?_⟩, by decide⟩
  · intro k hk hk0
    rcases (hsupp k).1 hk with h | h | h
    · exact absurd h hk0
    · subst h; norm_num
    · subst h; norm_num
  · exact d_le_of_two_points (k₁ := 4) (D := 3) h4 h7 (by norm_num) (by norm_num)
  · intro b' hb'
    have := hb' 4 h4 (by norm_num)
    omega

theorem example_28_40_52 {μ : PMF ℕ} (hc : IsCritical μ)
    (hsupp : ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 28 ∨ k = 40 ∨ k = 52) :
    ¬ Aperiodic μ ∧ IsSuppSpan μ 12 4 ∧ arithFactor μ {0} = 3 ∧
      {n : ℕ | leafProb μ n = 0}.Infinite := by
  have h28 : μ 28 ≠ 0 := (hsupp 28).2 (by simp)
  have h40 : μ 40 ≠ 0 := (hsupp 40).2 (by simp)
  have h52 : μ 52 ≠ 0 := (hsupp 52).2 (by simp)
  have hne : μ 1 ≠ 1 := mu_one_ne_one (by
    by_contra h
    have := (hsupp 1).1 h
    omega)
  have hAF : arithFactor μ {0} = 3 := by
    rw [BGWLeaves.LeafMass.Arithmetic.arithFactor_zero_eq_setGcd hc hne]
    have hset : {i : ℕ | μ (i + 1) ≠ 0} = {27, 39, 51} := by
      ext i
      simp only [Set.mem_ofPred_eq, hsupp, Set.mem_insert_iff, Set.mem_singleton_iff]
      omega
    rw [hset]
    apply Nat.dvd_antisymm
    · have a := Nat.setGcd_dvd_of_mem (show 27 ∈ ({27, 39, 51} : Set ℕ) by simp)
      have b := Nat.setGcd_dvd_of_mem (show 39 ∈ ({27, 39, 51} : Set ℕ) by simp)
      have := Nat.dvd_gcd a b
      simpa using this
    · rw [Nat.dvd_setGcd_iff]
      intro m hm
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hm
      omega
  refine ⟨not_aperiodic_of_dvd (g := 4) (by norm_num) ?_,
    ⟨by norm_num, ?_, ?_, ?_⟩, hAF, ?_⟩
  · intro k hk
    rcases (hsupp k).1 hk with h | h | h | h <;> subst h <;> norm_num
  · intro k hk hk0
    rcases (hsupp k).1 hk with h | h | h | h
    · exact absurd h hk0
    all_goals subst h; norm_num
  · exact d_le_of_two_points (k₁ := 28) (D := 12) h28 h40 (by norm_num) (by norm_num)
  · intro b' hb'
    have := hb' 28 h28 (by norm_num)
    omega
  · refine Set.infinite_of_injective_forall_mem (f := fun j : ℕ => 3 * j + 2)
      (fun a b h => by simp at h; omega) fun j => ?_
    show leafProb μ (3 * j + 2) = 0
    have := BGWLeaves.LeafMass.Arithmetic.leafProb_eq_zero_of_not_dvd hc hne
      (n := 3 * j + 1) (by rw [hAF]; omega)
    simpa using this

theorem example_3_6 {μ : PMF ℕ} (hc : IsCritical μ)
    (hsupp : ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 3 ∨ k = 6) :
    ¬ Aperiodic μ ∧ IsSuppSpan μ 3 0 ∧ arithFactor μ {0} = 1 ∧
      {n : ℕ | leafProb μ n = 0} = {0, 2, 4} := by
  have h3 : μ 3 ≠ 0 := (hsupp 3).2 (by simp)
  have h6 : μ 6 ≠ 0 := (hsupp 6).2 (by simp)
  have hne : μ 1 ≠ 1 := mu_one_ne_one (by
    by_contra h
    have := (hsupp 1).1 h
    omega)
  have hset : {i : ℕ | μ (i + 1) ≠ 0} = {2, 5} := by
    ext i
    simp only [Set.mem_ofPred_eq, hsupp, Set.mem_insert_iff, Set.mem_singleton_iff]
    omega
  have hAF : arithFactor μ {0} = 1 := by
    rw [BGWLeaves.LeafMass.Arithmetic.arithFactor_zero_eq_setGcd hc hne, hset]
    have a := Nat.setGcd_dvd_of_mem (show 2 ∈ ({2, 5} : Set ℕ) by simp)
    have b := Nat.setGcd_dvd_of_mem (show 5 ∈ ({2, 5} : Set ℕ) by simp)
    have := Nat.dvd_gcd a b
    simpa using this
  have hmon : leafMonoid μ = AddSubmonoid.closure ({2, 5} : Set ℕ) := by
    unfold leafMonoid
    rw [hset]
  have key : ∀ m : ℕ, m ∈ leafMonoid μ ↔ m ≠ 1 ∧ m ≠ 3 := by
    intro m
    rw [hmon]
    constructor
    · intro hm
      let S : AddSubmonoid ℕ :=
        { carrier := {m | m ≠ 1 ∧ m ≠ 3}
          zero_mem' := by simp
          add_mem' := by
            intro a b ha hb
            simp only [Set.mem_ofPred_eq] at *
            omega }
      have hle : AddSubmonoid.closure ({2, 5} : Set ℕ) ≤ S := by
        rw [AddSubmonoid.closure_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        show x ≠ 1 ∧ x ≠ 3
        omega
      exact hle hm
    · rintro ⟨h1, h3'⟩
      have h2 : (2 : ℕ) ∈ AddSubmonoid.closure ({2, 5} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      have h5 : (5 : ℕ) ∈ AddSubmonoid.closure ({2, 5} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      rcases Nat.even_or_odd' m with ⟨j, hj | hj⟩
      · have := nsmul_mem h2 j
        rw [smul_eq_mul] at this
        rw [hj]; simpa [mul_comm] using this
      · have hj2 : 2 ≤ j := by omega
        have := add_mem h5 (nsmul_mem h2 (j - 2))
        rw [smul_eq_mul] at this
        have e : m = 5 + (j - 2) * 2 := by omega
        rw [e]; exact this
  refine ⟨not_aperiodic_of_dvd (g := 3) (by norm_num) ?_, ⟨by norm_num, ?_, ?_, ?_⟩, hAF, ?_⟩
  · intro k hk
    rcases (hsupp k).1 hk with h | h | h <;> subst h <;> norm_num
  · intro k hk hk0
    rcases (hsupp k).1 hk with h | h | h
    · exact absurd h hk0
    all_goals subst h; norm_num
  · exact d_le_of_two_points (k₁ := 3) (D := 3) h3 h6 (by norm_num) (by norm_num)
  · intro b' _
    exact Nat.zero_le _
  · ext n
    simp only [Set.mem_ofPred_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
    rcases n with _ | m
    · simp [leafProb_zero]
    · rw [leafProb_eq_zero_iff hc hne, key]
      omega

/-! ## Non-vacuity -/

theorem exists_crit_of_weights (s : Finset ℕ) (w : ℕ → ℝ≥0) (hz : ∀ k ∉ s, w k = 0)
    (hnz : ∀ k ∈ s, w k ≠ 0) (h1 : ∑ k ∈ s, w k = 1) (h2 : ∑ k ∈ s, (k : ℝ≥0) * w k = 1) :
    ∃ μ : PMF ℕ, IsCritical μ ∧ ∀ k, μ k ≠ 0 ↔ k ∈ s := by
  refine ⟨PMF.ofFinset (fun k => (w k : ℝ≥0∞)) s ?_ ?_, ?_, ?_⟩
  · rw [← ENNReal.ofNNReal_finsetSum, h1]; simp
  · intro a ha; simp [hz a ha]
  · unfold IsCritical
    simp only [PMF.ofFinset_apply]
    rw [tsum_eq_sum (s := s) (fun b hb => by simp [hz b hb])]
    have : ∑ k ∈ s, (k : ℝ≥0∞) * (w k : ℝ≥0∞) = ((∑ k ∈ s, (k : ℝ≥0) * w k : ℝ≥0) : ℝ≥0∞) := by
      push_cast; rfl
    rw [this, h2]; simp
  · intro k
    simp only [PMF.ofFinset_apply, ne_eq, ENNReal.coe_eq_zero]
    constructor
    · intro h
      by_contra hk
      exact h (hz k hk)
    · exact hnz k

theorem exists_examples :
    (∃ μ : PMF ℕ, IsCritical μ ∧ ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 28 ∨ k = 40 ∨ k = 52) ∧
    (∃ μ : PMF ℕ, IsCritical μ ∧ ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 3 ∨ k = 6) ∧
    (∃ μ : PMF ℕ, IsCritical μ ∧ ∀ k, μ k ≠ 0 ↔ k = 0 ∨ k = 4 ∨ k = 7) := by
  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨μ, hc, hs⟩ := exists_crit_of_weights {0, 28, 40, 52}
      (fun k => if k = 0 then 39 / 40 else if k = 28 ∨ k = 40 ∨ k = 52 then 1 / 120 else 0)
      (by intro k hk; simp at hk; simp [hk.1, hk.2.1, hk.2.2.1, hk.2.2.2])
      (by
        intro k hk
        simp only [Finset.mem_insert, Finset.mem_singleton] at hk
        rcases hk with rfl | rfl | rfl | rfl <;> norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
    exact ⟨μ, hc, fun k => by rw [hs]; simp⟩
  · obtain ⟨μ, hc, hs⟩ := exists_crit_of_weights {0, 3, 6}
      (fun k => if k = 0 then 3 / 4 else if k = 3 then 1 / 6 else if k = 6 then 1 / 12 else 0)
      (by intro k hk; simp at hk; simp [hk.1, hk.2.1, hk.2.2])
      (by
        intro k hk
        simp only [Finset.mem_insert, Finset.mem_singleton] at hk
        rcases hk with rfl | rfl | rfl <;> norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
    exact ⟨μ, hc, fun k => by rw [hs]; simp⟩
  · obtain ⟨μ, hc, hs⟩ := exists_crit_of_weights {0, 4, 7}
      (fun k => if k = 0 then 57 / 70 else if k = 4 then 1 / 10 else if k = 7 then 3 / 35 else 0)
      (by intro k hk; simp at hk; simp [hk.1, hk.2.1, hk.2.2])
      (by
        intro k hk
        simp only [Finset.mem_insert, Finset.mem_singleton] at hk
        rcases hk with rfl | rfl | rfl <;> norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
      (by
        simp [Finset.sum_insert]
        rw [← NNReal.coe_inj]; push_cast; norm_num)
    exact ⟨μ, hc, fun k => by rw [hs]; simp⟩

end BGWLeaves.LeafMass.Remarks
