# Inactive template. Install in an authorized workflow host after the source
# repository is public and the exact candidate commit has been selected.
# Pipeline HEAD checked on 13 November 2026. Keep both pipeline pins identical.
name: Full Palomar mechanical verification

on:
  workflow_dispatch:
    inputs:
      commit:
        description: Exact public source commit (40 lowercase hexadecimal characters)
        required: true
        type: string
      request_id:
        description: Unique request identifier (12 lowercase alphanumeric characters)
        required: true
        type: string

permissions:
  contents: read

jobs:
  palomar:
    uses: PalomarRegistry/PalomarSubmission/.github/workflows/submission.yml@14aa8d6b3c2f14a8540605e37144560b9a00e7e7
    with:
      repository: igor-kortchemski/invariance-principles-galton-watson-lean
      commit: ${{ inputs.commit }}
      pipeline_commit: 14aa8d6b3c2f14a8540605e37144560b9a00e7e7
      request_id: ${{ inputs.request_id }}
      mode: full
      execution_profile: palomar-standard-v1
      options: '{"comparator_config_path":"comparator.json","authorization_relationship":"I am a responsible author or maintainer"}'
